{
  "name": "@agrippa-io/rest-request",
  "version": "1.0.1",
  "description": "HTTP module for making RESTful requests following the Agrippa request patterns and conventions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sdk",
    "client",
    "http",
    "actions"
  ],
  "author": "Agrippa Development Team",
  "license": "ISC",
  "dependencies": {
    "axios": "^0.21.1",
    "change-case": "^4.1.1",
    "lodash": "^4.17.20",
    "qs-stringify": "^1.2.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.12.0",
    "@types/chai": "^4.3.20",
    "@types/lodash": "^4.17.7",
    "@types/node": "^22.19.19",
    "@typescript-eslint/parser": "^8.18.0",
    "chai": "^4.5.0",
    "eslint": "^9.17.0",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
